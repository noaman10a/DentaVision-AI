# ============================================================
# DentaVision AI — Backend Environment Variables
# Owner: Twahir (Backend Lead)
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Supabase (Database + Auth + Storage) ---
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Database (Prisma + PostgreSQL via Supabase) ---
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- AI Service ---
# Local FastAPI service run by Soha (default port 8000)
AI_SERVICE_URL=http://localhost:8000

# --- CORS ---
# Comma-separated allowed origins (use * for development only)
CORS_ORIGIN=*
